#!/usr/bin/env bash
# fg — Fizzygum cross-repo workflow wrapper. Runnable from ANY cwd.
#
# WHY THIS EXISTS: the build (build_it_please.sh) lives in Fizzygum/, but the
# test / smoke / capture node scripts live in Fizzygum-tests/scripts/. Hand-chaining
# them in one shell line repeatedly ran the test scripts from the WRONG cwd
# (MODULE_NOT_FOUND), and the failure hid behind a masked exit code. This wrapper
# ALWAYS cd's to the right repo internally, gates on REAL exit codes (never a pipe),
# kills zombie headless browsers, and prints a loud PASS/FAIL banner. It deliberately
# does NOT name the raw scripts at its call site, so it bypasses the PreToolUse guard.
#
# WHERE IT LIVES: in the Fizzygum repo (Fizzygum/fg), because committed code reads it —
# buildSystem/lib/what-runs.js parses its functions, and reads the leg table they run
# (buildSystem/legs.js), to learn which scripts the commit-point legs launch. The umbrella keeps a two-line shim at Fizzygum-all/fg that execs this file, so
# `<umbrella>/fg <cmd>` and `Fizzygum/fg <cmd>` are the same command. ROOT is the umbrella either way.
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FZ="$ROOT/Fizzygum"
FT="$ROOT/Fizzygum-tests"
[ -x "$FZ/build_it_please.sh" ] || { echo "fg FATAL: $FZ/build_it_please.sh not found — fg lives in Fizzygum/, beside its sibling Fizzygum-tests/"; exit 3; }
[ -d "$FT/scripts" ]           || { echo "fg FATAL: $FT/scripts not found"; exit 3; }

ban(){ echo; echo "================================ $* ================================"; }
# Verdict files — /tmp/fg-<cmd>.verdict holds "RUNNING since …" while a long op runs and
# "<CMD> EXIT=<rc> …" when it ends. Lets an agent check a backgrounded run's state with ONE
# command (`cat /tmp/fg-gauntlet.verdict`) instead of a foreground grep/sleep poll loop
# (which the cmd-guard hook now blocks). Overwritten at the START of each run so a stale
# verdict from a previous run can never be misread as this run's result.
# verdict_start also does the machine-state pre-flight (2026-08-05 workflow audit): the
# 2026-08-04→05 overnight gauntlet ran 7 h (total=25457s, three INFRA-FLAKE legs, refs 2122s vs
# ~22s normal) because the machine slept/was overloaded mid-run — the "all-DISCONNECTED failed:0"
# signature. caffeinate holds sleep off for exactly this fg process's lifetime (exits with it),
# and the 1-min loadavg is stamped into the RUNNING verdict so an overloaded start is readable in
# ONE peek — with a loud banner when load already ≥ core count.
verdict_start(){
  command -v caffeinate >/dev/null 2>&1 && { caffeinate -dims -w $$ >/dev/null 2>&1 & }
  local load cores warn=""
  load=$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}')
  cores=$(sysctl -n hw.ncpu 2>/dev/null || echo 8)
  if [ -n "$load" ] && [ "${load%%.*}" -ge "$cores" ] 2>/dev/null; then
    warn=" ⚠load≥cores"
    ban "⚠ PRE-FLIGHT: 1-min loadavg $load ≥ $cores cores — a parallel run on a busy machine yields INFRA-FLAKE legs and false FAILs (2026-08-04 lesson: 7 h gauntlet, wasted night); consider waiting, or FG_GAUNTLET_SERIAL=1"
  fi
  echo "RUNNING since $(date '+%F %T') pid=$$ load=${load:-?}$warn" > "/tmp/fg-$1.verdict"
}
verdict_end(){ local n="$1" rc="$2"; shift 2; echo "$(echo "$n" | tr '[:lower:]' '[:upper:]') EXIT=$rc $* ($(date '+%F %T'))" > "/tmp/fg-$n.verdict"; }

# legs_pending <cmd> <leg…> — stamp every leg log PENDING at run start, the same stale-proofing the
# verdict gets above.
# ⚠ WHY: run_leg truncates /tmp/fg-<leg>.log only when THAT LEG STARTS, but a gauntlet runs lint+build
# (~1 min) first — so for that whole minute every leg log still holds the PREVIOUS run's contents.
# Anything reading them mid-run (a human peeking with `tail`, an agent's progress monitor) sees the
# last run's results attributed to this one. On 2026-07-15 that read `webkit=248/248` and a stale
# `Network.enable timed out` ONE MINUTE into a fresh run, and raised a false infra-flake alarm.
# Cheap, exact, and it makes "is this line from this run?" answerable without checking mtimes.
legs_pending(){ local cmd="$1" l; shift; for l in "$@"; do
  echo "PENDING — $cmd started $(date '+%F %T') pid=$$; leg '$l' has not run yet." > "/tmp/fg-$l.log"
  echo "(stamped at run start; replaced by real output when the leg begins. If you are reading THIS," >> "/tmp/fg-$l.log"
  echo " the leg is still queued — do not read anything into it.)" >> "/tmp/fg-$l.log"
done; }
kill_browsers(){ pkill -9 -f "Chrome for Testing|chrome-headless|puppeteer|webkit" >/dev/null 2>&1 || true; sleep 1; }
# hard timeout without `timeout` (absent in this env): perl alarm
to(){ local s="$1"; shift; perl -e 'alarm shift; exec @ARGV' "$s" "$@"; }
# legs <request…>: the gauntlet's leg table (buildSystem/legs.js) as bash reads it — `names <wave|presuite|gauntlet|infra>`,
# `row <leg>`, `headline <leg>`, `banner <wave>`, `roster`; it exits 2, saying why, on a table it cannot run
legs(){ ( cd "$FZ" && node buildSystem/legs.js --shell "$@" ); }
# leg_list_ok "<names>": a list the table gave holds at least one leg and nothing but leg names
leg_list_ok(){ [ -n "$1" ] && ! printf '%s' "$1" | grep -q '[^a-z0-9 -]'; }
# legs_all_ran <leg…>: after the waves, every leg the run named has a result; one that never ran fails the run (ok=0),
# so a wave that ran fewer legs than its list can never read as a green run
legs_all_ran(){
  local n
  for n in "$@"; do
    case " $WAVE_RES " in *" $n="*) ;; *) tally="$tally $n:NEVER-RAN"; ok=0; echo "✗ $n never ran: no wave started it" ;; esac
  done
}

# build in Fizzygum/, gate on REAL exit + done!!! + 0 violations (stale-build safe)
fg_build(){
  local log=/tmp/fg-build.log
  ( cd "$FZ" && ./build_it_please.sh "$@" ) >"$log" 2>&1; local rc=$?
  grep -E 'selftests\] (OK|FAIL)|syntax check:|layering gate|dead-methods\]|unresolved-sends\]|call-separation\]|stinks\] (OK|FAIL)|thin-wraps\] (OK|FAIL)|test \.js syntax|aim-census\] (OK|FAIL)' "$log" | tail -10
  if [ $rc -ne 0 ] || ! grep -q 'done!!!' "$log"; then ban "BUILD FAILED (exit $rc, no done!!!)"; tail -20 "$log"; return 1; fi
  if grep -qE '[1-9][0-9]* violation' "$log"; then ban "LINT VIOLATION"; grep -nE 'violation|\[[A-F]\]' "$log" | tail -20; return 1; fi
  echo "  build OK — 0 violations, done!!!"; return 0
}

# A tier that RUNS THE SUITE (presuite, gauntlet) must build a tree that ships the harness page the suite
# drives (worldWithSystemTestHarness.html). Handed a profile without it (homepage, lean, dev-notests,
# dev-precompiled), it would build a tree the runners cannot drive and fail a long way from its cause — so the
# profile is asked first, through the one reader of profiles, and nothing is built. Exit 2: nothing was measured.
suite_profile_or_refuse(){
  ( cd "$FZ" || exit 2
    vars=$(node ./buildSystem/lib/profile.js --shell "$@") || { echo "fg: could not read the build profile — nothing was built."; exit 2; }
    eval "$vars"
    $PROFILE_SHIPS_HARNESS_ENTRY && exit 0
    echo "fg: profile '$PROFILE_NAME' ships no harness page, so the suite cannot run on it — nothing was built. Use the default (dev) profile; for a boot check of this one, build_and_smoke.sh (or fg homepage)."
    exit 2 )
}

# full headless suite vs the CURRENT build. In a parallel gauntlet/presuite wave (FG_PARALLEL=1)
# the pkill is skipped — the wave did ONE global kill up front and legs must not cull each other.
fg_suite(){ [ "${FG_PARALLEL:-0}" = 1 ] || kill_browsers; ( cd "$FT" && to 900 node scripts/run-all-headless.js "$@" --shards=8 ); }  # "$@" first so a user --shards=N overrides the default 8 (run-all-headless is first-wins)

# fg lint (plan P4.1): PRE-BUILD static checks in ~2 s, scoped to git-CHANGED files. Catches the
# recurring backtick-inside-a-macro-comment JS breakage (and any .coffee parse error) BEFORE a
# minutes-long build/suite does. gauntlet/presuite run it first (fail fast); `fg lint` runs it alone.
run_lint(){
  local t0=$SECONDS lrc=0 f tjs coffee_changed
  # changed/untracked test .js → node --check each (macro sources are template-literal JS files).
  # ALSO scripts/*.js: they are the only locally-runnable code in the repo and NOTHING gated them
  # (this regex was anchored ^tests/, check-tests-syntax.js is scoped to tests/SystemTest_*/, and
  # jscpd only scans Fizzygum/src/**/*.coffee) — a syntax error in scripts/lib/*.js was caught by
  # nothing until it ran. node --check is ~free, so widen rather than keep the hole.
  tjs=$(git -C "$FT" status --porcelain 2>/dev/null | awk '{print $NF}' | grep -E '^(tests|scripts)/.*\.js$')
  for f in $tjs; do
    [ -f "$FT/$f" ] || continue
    if ! node --check "$FT/$f" 2>/tmp/fg-lint-err.txt; then
      echo "✗ fg lint: JS syntax error in Fizzygum-tests/$f"
      sed 's/^/    /' /tmp/fg-lint-err.txt | head -8
      lrc=1
    fi
  done
  # any changed .coffee (src OR harness) → the build's own fragmented-compile syntax gate (~1.5 s full tree)
  coffee_changed=$( { git -C "$FZ" status --porcelain 2>/dev/null; git -C "$FT" status --porcelain 2>/dev/null; } | awk '{print $NF}' | grep -cE '\.coffee$')
  if [ "$coffee_changed" -gt 0 ]; then
    if ! ( cd "$FZ" && node buildSystem/check-coffee-syntax.js ) >/tmp/fg-lint-coffee.log 2>&1; then
      echo "✗ fg lint: CoffeeScript syntax gate FAILED:"; tail -10 /tmp/fg-lint-coffee.log; lrc=1
    fi
  fi
  # macro SOURCE DISCIPLINE (build gate #27, Fizzygum-tests/scripts/check-macro-source-discipline.js):
  # `@evaluateString` is always wrong (MacroToolkit's own -- a different method), and
  # `world.evaluateString` is allowed only where the test DECLARES the eval as its subject via its
  # `evaluateString` tag. The BUILD is the gate of record; running it here too just turns a
  # build-abort into an instant answer while editing a macro. Whole-tree scan, ~30ms, so it is not
  # worth restricting to changed files -- but it only has anything to say when tests/ moved.
  if echo "$tjs" | grep -q '^tests/'; then
    if ! ( cd "$FT" && node scripts/check-macro-source-discipline.js ) >/tmp/fg-lint-macrosrc.log 2>&1; then
      echo "✗ fg lint: macro source-discipline gate FAILED:"; sed 's/^/    /' /tmp/fg-lint-macrosrc.log | head -12; lrc=1
    fi
  fi
  if [ $lrc -eq 0 ]; then echo "  lint OK ($((SECONDS-t0))s — $(echo "$tjs" | grep -c .) changed test/script .js checked, coffee gate $([ "$coffee_changed" -gt 0 ] && echo run || echo skipped))"; return 0
  else ban "FG LINT FAILED"; return 1; fi
}

# ---------- gauntlet legs (dev-workflow plan P1: parallel waves + serial retry) ----------
# run_leg <name>: ONE gauntlet leg → /tmp/fg-<name>.log; returns the leg's REAL exit code and
# appends an "fg-leg: <name> rc=<rc> <secs>s" stamp to the log. The SAME definitions serve the
# parallel waves (backgrounded), the serial path and the serial retry (foreground).
# Tunables: FG_SUITE_SHARDS (suite legs; wave default 4 → 3 concurrent suites × 4 = 12 browsers),
# FG_GATE_SHARDS (the gates' embedded suites; their own default is 6, waves pass 4).
run_leg(){
  local name="$1" lg="/tmp/fg-$1.log" t0=$SECONDS rc=1
  # The suite runner writes every failure image its shards catch to this directory
  # (run-all-headless.js, FIZZYGUM_FAILURE_IMAGES_DIR) — exported for this leg only, cleared at its
  # start. Without it a parallel-only pixel failure leaves just its verdict line: the images live in
  # the shard's page and die with it. collect_and_retry keeps a failed wave's set beside its log.
  local FIZZYGUM_FAILURE_IMAGES_DIR="/tmp/fg-$1.failure-images"; export FIZZYGUM_FAILURE_IMAGES_DIR
  rm -rf "$FIZZYGUM_FAILURE_IMAGES_DIR"
  # THE LEG'S ROW (buildSystem/legs.js, the one list of the legs and of how each runs): its steps, each in a subshell of
  # its own, the log truncated once and appended to, the first failing step ending the leg with its exit code; `{SUITE_SHARDS}`
  # / `{GATE_SHARDS}` take the shard counts the caller set. A name the table does not hold is a hard failure.
  local row f i dir passline="" steps=0
  # the reader's stderr is no part of the row: kept aside, it is the log's reason only when the reader refuses
  if row=$(legs row "$name" 2>"$lg.legs-err"); then
    rm -f "$lg.legs-err"; : >"$lg"; rc=0
    while IFS=$'\t' read -r -a f <&3; do
      [ ${#f[@]} -gt 0 ] || f=("")
      for i in "${!f[@]}"; do
        f[$i]="${f[$i]//\{SUITE_SHARDS\}/${FG_SUITE_SHARDS:-4}}"; f[$i]="${f[$i]//\{GATE_SHARDS\}/${FG_GATE_SHARDS:-6}}"
      done
      case "${f[0]:-}" in
        passline) passline="${f[1]}" ;;
        suite) steps=$((steps+1)); fg_suite "${f[@]:1}" >>"$lg" 2>&1 || { rc=$?; break; } ;;
        step) steps=$((steps+1)); if [ "${f[1]}" = fizzygum ]; then dir="$FZ"; else dir="$FT"; fi
              ( cd "$dir" && to "${f[2]}" node "${f[@]:3}" ) >>"$lg" 2>&1 || { rc=$?; break; } ;;
        # a line the reader should never give: the leg FAILS rather than run less than its row
        *) echo "run_leg: the leg table gave a line run_leg cannot read: ${f[*]:-}" >>"$lg"; rc=1; break ;;
      esac
    done 3<<< "$row"
    [ $steps -gt 0 ] || { echo "run_leg: the leg table gave no step for $name" >>"$lg"; rc=1; }
    # a leg whose program also prints its verdict passes only with that line in its log
    [ -n "$passline" ] && { { [ $rc -eq 0 ] && grep -q -- "$passline" "$lg"; } || rc=1; }
  else
    { printf 'run_leg: '; cat "$lg.legs-err"; } >"$lg"; rm -f "$lg.legs-err"; rc=1
  fi
  echo "fg-leg: $name rc=$rc $((SECONDS-t0))s" >>"$lg"
  # Refresh this leg's STANDALONE verdict file, but only if one already exists. Several legs
  # (revisits, storage, vmtruth, ...) are also standalone verbs that write /tmp/fg-<name>.verdict,
  # and a gauntlet used to leave those untouched — so `fg status` could show
  # "REVISITS EXIT=1 FAILED" from days ago immediately beside a green gauntlet that had just
  # re-run that very gate. At a cold session start that reads as a real failure and costs a
  # detour. Refreshing only pre-existing files keeps `fg status` truthful without adding a
  # verdict line per leg (twenty of them would drown the section it is meant to summarise).
  [ -f "/tmp/fg-$name.verdict" ] && verdict_end "$name" "$rc" "$(case $rc in (0) echo OK;; (2) echo INVALID;; (3) echo INFRA-FLAKE;; (*) echo FAILED;; esac) (gauntlet leg)"
  return $rc
}
leg_secs(){ sed -n 's/^fg-leg: .* rc=[0-9]* \([0-9]*s\)$/\1/p' "/tmp/fg-$1.log" 2>/dev/null | tail -1; }
leg_headline(){ grep -E "$(legs headline "$1")" "/tmp/fg-$1.log" 2>/dev/null | tail -2 | sed 's/^/    /'; }
# infra_leg <leg>: is the leg's exit 3 an INFRA flake (an audited-suite gate's shard dropped twice), per the table?
infra_leg(){ case " $INFRA_LEGS " in *" $1 "*) return 0 ;; esac; return 1; }

# run_wave <legs…>: background each leg with the browser-cull suppressed (ONE global kill ran
# before the first wave), wait for all, append "name=rc" pairs to WAVE_RES, print headlines.
run_wave(){
  local n pids="" pair rc
  for n in "$@"; do
    ( export FIZZYGUM_KEEP_STALE_BROWSERS=1 FG_PARALLEL=1; run_leg "$n" ) &
    pids="$pids $n:$!"
  done
  for pair in $pids; do
    n="${pair%%:*}"
    wait "${pair#*:}"; rc=$?
    WAVE_RES="$WAVE_RES $n=$rc"
    echo "--- $n (rc=$rc, $(leg_secs "$n")) ---"; leg_headline "$n"
  done
}

# After the waves: PASS legs → tally; each FAILED leg → ONE serial retry, alone, browsers cleared
# (plan P1.2 step 4). Pass-on-retry = load-flake WARNING (gauntlet still passes, loudly, with the
# parallel-fail log preserved as /tmp/fg-<leg>.parallel-fail.log, and any failure images the wave's
# shards caught as /tmp/fg-<leg>.parallel-fail.images); fail-on-retry = real FAIL.
# Sets ok/warn/tally in the caller's scope.
collect_and_retry(){
  local pair n rc pimgs
  for pair in $WAVE_RES; do
    n="${pair%%=*}"; rc="${pair#*=}"
    if [ "$rc" -eq 0 ]; then
      tally="$tally $n:PASS($(leg_secs "$n"))"
    else
      ban "$n FAILED in parallel (rc=$rc) — retrying serially, alone"
      tail -15 "/tmp/fg-$n.log"
      cp "/tmp/fg-$n.log" "/tmp/fg-$n.parallel-fail.log" 2>/dev/null
      # the retry's run_leg clears the leg's image dir, so the wave's pictures move out first
      rm -rf "/tmp/fg-$n.parallel-fail.images"
      pimgs=""
      if [ -d "/tmp/fg-$n.failure-images" ] && [ -n "$(ls -A "/tmp/fg-$n.failure-images")" ]; then
        mv "/tmp/fg-$n.failure-images" "/tmp/fg-$n.parallel-fail.images"
        pimgs="; its failure images at /tmp/fg-$n.parallel-fail.images"
      fi
      kill_browsers
      if run_leg "$n"; then
        tally="$tally $n:PASS-serial-only"; warn=1
        echo "⚠ $n: FAILED-parallel/PASSED-serial — possible load-sensitive nondeterminism (see Fizzygum-tests/DETERMINISM.md); parallel log kept at /tmp/fg-$n.parallel-fail.log$pimgs"
      else
        rc2=$?
        if [ "$rc2" -eq 3 ] && infra_leg "$n"; then
          # plan P6: a gate that exits 3 dropped a shard TWICE with zero failed tests — infra, not a failure
          tally="$tally $n:INFRA-FLAKE"; warn=1
          echo "⚠ $n: INFRA shard-drop (exit 3) — zero failed tests, NOT a test/audit failure (plan P6). Re-run the gate if paranoid; log: /tmp/fg-$n.log"
        else
          tally="$tally $n:FAIL"; ok=0
          echo "--- $n serial retry also FAILED ---"; tail -25 "/tmp/fg-$n.log"
          [ -n "$(ls -A "/tmp/fg-$n.failure-images" 2>/dev/null)" ] && echo "  failure images: /tmp/fg-$n.failure-images"
        fi
      fi
    fi
  done
}

usage(){ cat <<'EOF'
fg — Fizzygum cross-repo wrapper (run from ANY cwd:  <umbrella>/fg <cmd>  or  <umbrella>/Fizzygum/fg <cmd>)
  fg build [flags]                          build in Fizzygum/ (verifies 0 violations + done!!!)
  fg suite [--dpr=2|--browser=webkit|...]   full headless suite vs the current build (8 shards)
EOF
legs roster   # the presuite's and the gauntlet's legs, and the gates whose exit 3 is infra: the leg table (buildSystem/legs.js)
cat <<'EOF'
                                            Fizzygum-tests/scripts/lib/audited-suite.js) retry a dropped shard themselves; exit 3
                                            (dropped twice, zero failed tests) reads INFRA-FLAKE — re-run, never a FAIL.
                                            The settle leg also RIDES the cached-vs-SLOW twins check (doubleCheckCachedMethodsResults suite-wide; CACHED_DERIVATION_DIVERGED fail-gated).
                                            FG_GAUNTLET_SERIAL=1 fg gauntlet = old sequential path.
  fg revisits|storage|vmtruth [gate args]   gate args, as every audited-suite gate takes them: [shards=6] [--tests=A,B]
                                            [--prelude=FILE] [--out=DIR] [--audit-dir=DIR] (judge an existing dir, run no suite)
  fg revisits                               the SETTLE-RE-VISIT standing gate (~2 min): suite under the
                                            audit prelude, profile asserted vs scripts/revisit-baseline.json
                                            (EMPTY since the up-edge endgame: ANY re-visit = regression).
                                            Also a gauntlet wave-B leg — every commit-point run enforces it.
  fg storage                                the bin/shelf storage DEEP AUDIT (Tier B, ~2 min): suite under
                                            the storage prelude — per-test force-drain + from-scratch
                                            reclassify asserting ZERO moves + residue checks; the profile
                                            must be EMPTY (no baseline file on purpose). Tier A (the
                                            STORAGE_INVARIANT token) already rides every suite leg.
                                            Also a gauntlet wave-B leg — every commit-point run enforces it.
  fg finger                                 THE SUITE AS A FINGER (~6 min, gauntlet wave-D leg): every
                                            intent verb translated to the touch gesture carrying the
                                            same intent, matched against the finger reference axis
                                            (…/ceilPixRatio_<N>/finger/). WebKit + dpr2 = "an iPad"
                                            (ruling H2). Mouse-only-by-meaning tests (pointerKinds
                                            metadata) are filtered by the loader.
  fg vmtruth                                the VM-TRUTH object-lifetime gate (Arc B, ~2 min): suite under
                                            a forced-GC prelude — every destroyed widget must be
                                            GC-collectible one teardown later (closure retention the
                                            in-band WORLD_INVENTORY gate cannot see: it never walks
                                            functions) + a post-GC heap-floor ceiling per page.
                                            Verdicts: OK / FAILED / INVALID(2) = measured nothing,
                                            never a pass / INFRA-FLAKE(3). Chrome-only by design (the webkit
                                            leg keeps the in-band tier). Localize findings with
                                            scripts/heap-forensics.js (its self-test runs in the selftests leg).
                                            Also a gauntlet leg (wave C) — every commit point enforces it.
  fg census                                 the ARRANGE-IDEMPOTENCE oracle (~10s): boot + app battery
                                            + resizes, then post-order force-re-lay EVERY widget at its
                                            current frame — any mover / battery skip / page error FAILS.
                                            Run for any arrange/engine change (needs a fresh build).
