#!/usr/bin/env node
'use strict';
// fg — the Fizzygum workspace's workflow wrapper: build, test, the commit-point check. Runnable from ANY cwd:
// `<umbrella>/fg <cmd>` (the umbrella's two-line shim execs this file) or `<umbrella>/Fizzygum/fg <cmd>`; `fg` alone
// prints every verb.
//
// WHY THIS EXISTS: the build (build_it_please.sh) lives in Fizzygum/, but the test, smoke and capture scripts live in
// Fizzygum-tests/scripts/. Hand-chaining them in one shell line repeatedly ran a script from the WRONG cwd
// (MODULE_NOT_FOUND) and hid the failure behind a masked exit code. fg always runs each program from its own repo,
// gates on REAL exit codes, kills leftover headless browsers, and prints a loud PASS/FAIL banner.
//
// WHERE IT LIVES: in the Fizzygum repo, beside the build. This file is only the entry point; the program is
// buildSystem/fg-verbs.js (the verbs and the dispatcher), buildSystem/fg-commit-point.js (the build, the lint, the
// suite and the gauntlet's legs, which lib/what-runs.js reads as the commit point's root) and buildSystem/lib/
// fg-supervisor.js (how a program is started, timed out and made to end, with everything it started).
require('./buildSystem/fg-verbs').main(process.argv.slice(2)).then(
  (rc) => require('./buildSystem/lib/fg-supervisor').finish(rc),
  (e) => { process.stderr.write(`fg: internal error: ${e && e.stack ? e.stack : e}\n`); require('./buildSystem/lib/fg-supervisor').finish(2); });
