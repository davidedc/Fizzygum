
**/.DS_Store
**/node_modules
src/.idea/

# Vendored SWCanvas backend — bulk bytes are fetched on demand from the pin
# (vendor/swcanvas.pin), never committed. Same model as SWCanvas←BitmapText.
vendor/swcanvas/
# Vendored SWCanvas font atlases (downloaded from the release pin at build time).
font-assets/
# find_duplicated_code.sh (jscpd) output — regenerated on every run.
duplication-report/
# the build's record of the inputs it read (buildSystem/lib/build-inputs.js), kept beside the source, never in the
# tree it writes: it describes ../Fizzygum-builds/latest, and changes with every build.
/.latest-build-inputs
/.latest-build-inputs.reading
